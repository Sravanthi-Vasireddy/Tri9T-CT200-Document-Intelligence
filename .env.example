# Application Configuration
APP_NAME=Tri9T-CT200-Document-Intelligence
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Relational Database (SQLite by default, or PostgreSQL)
DATABASE_URL=sqlite:///./tri9t_doc_intel.db

# CORS Allowed Origins (comma-separated list for custom domains)
ALLOWED_ORIGINS=https://tri9t-ct-200-document-intelligence.vercel.app,http://localhost:5173

# Auto-seed CT-200 manuals on fresh database boot (true/false)
AUTO_SEED_DOCUMENTS=true

# Document Store (Options: 'json' or 'mongodb')
DOCUMENT_STORE_TYPE=json
JSON_STORE_DIR=./generated

# MongoDB Configuration (Applicable if DOCUMENT_STORE_TYPE=mongodb)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=tri9t_doc_intel

# LLM Provider Configuration for QA Test Generation
# Supported providers: openai, mock (supports OpenRouter/Ollama via LLM_BASE_URL)
LLM_PROVIDER=mock
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

