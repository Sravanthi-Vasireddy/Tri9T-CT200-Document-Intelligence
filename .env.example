# Application Configuration
APP_NAME=Tri9T-CT200-Document-Intelligence
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Relational Database (SQLite)
DATABASE_URL=sqlite:///./tri9t_doc_intel.db

# Document Store (Options: 'json' or 'mongodb')
DOCUMENT_STORE_TYPE=json
JSON_STORE_DIR=./generated

# MongoDB Configuration (Applicable if DOCUMENT_STORE_TYPE=mongodb)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=tri9t_doc_intel

# LLM Provider Configuration for QA Test Generation
# Supported providers: openai, anthropic, gemini, mock
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini
